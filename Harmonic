<!DOCTYPE html>
<html lang="ja">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Harmonic Bloom</title>

    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;700&family=Cormorant+Garamond:wght@300;400&display=swap" rel="stylesheet">
    <style>
/* ═══════════════════════════════════════════════════════
   CELESTIA — style.css
   全ページ共通スタイル
   読み込み順: style.css → [page].css
═══════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────────────
   DESIGN TOKENS
───────────────────────────────────────────────────── */
:root {
  /* backgrounds */
  --i0: #020208;
  --i1: #06060f;
  --i2: #0b0b1a;
  --i3: #111125;
  --i4: #18182e;

  /* gold */
  --g:  #D4AF37;
  --gh: #E8CC6A;
  --gl: #9A7E20;
  --gd: rgba(212,175,55,.12);

  /* text */
  --t0: #F0EDE6;
  --t1: #C4C0B6;
  --t2: #74706A;
  --t3: #3A3830;

  /* accent */
  --rose: #C49090;

  /* fonts */
  --fm: 'Shippori Mincho', serif;
  --fl: 'IM Fell English', serif;
  --fc: 'Cinzel', serif;
}

/* ─────────────────────────────────────────────────────
   RESET & BASE
───────────────────────────────────────────────────── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
}

body {
  background: var(--i0);
  color: var(--t1);
  font-family: var(--fm);
  overflow-x: hidden;
  line-height: 1.8;
}

::-webkit-scrollbar       { width: 2px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--gl); }

/* ─────────────────────────────────────────────────────
   STAR CANVAS  — 全ページ共通 fixed 背景
───────────────────────────────────────────────────── */
#star-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  width: 100%;
  height: 100%;
}

/* ─────────────────────────────────────────────────────
   LAYOUT SHELL
───────────────────────────────────────────────────── */
.site-wrap {
  position: relative;
  z-index: 1;
  max-width: 560px;
  margin: 0 auto;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
}

/* ─────────────────────────────────────────────────────
   HEADER
───────────────────────────────────────────────────── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 1.5rem;
  height: 52px;
  background: rgba(2,2,8,.82);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-bottom: 1px solid rgba(212,175,55,.13);
}

.header-logo {
  display: flex;
  align-items: center;
  gap: .55rem;
  font-family: var(--fc);
  font-size: .76rem;
  font-weight: 500;
  letter-spacing: .3em;
  color: var(--g);
  text-decoration: none;
}

.header-nav {
  display: flex;
  align-items: center;
  gap: 1.6rem;
}

.header-nav a {
  font-family: var(--fc);
  font-size: .45rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--t2);
  text-decoration: none;
  transition: color .2s;
}

.header-nav a:hover,
.header-nav a.active { color: var(--g); }

/* ─────────────────────────────────────────────────────
   MAIN CONTENT WRAPPER
───────────────────────────────────────────────────── */
.main-content {
  flex: 1;
  padding: 0 1.5rem 5rem;
}

/* ─────────────────────────────────────────────────────
   SECTION LABELS  — 全ページ共通
───────────────────────────────────────────────────── */
.s-eye {
  font-family: var(--fc);
  font-size: .44rem;
  letter-spacing: .36em;
  text-transform: uppercase;
  color: var(--g);
  opacity: .55;
  margin-bottom: .45rem;
  padding-top: 2.4rem;
}

.s-head {
  font-family: var(--fm);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--t0);
  letter-spacing: .05em;
  margin-bottom: .3rem;
}

.s-rule {
  width: 28px;
  height: 1px;
  background: linear-gradient(90deg, var(--g), transparent);
  margin-bottom: 1.8rem;
}

/* ─────────────────────────────────────────────────────
   BOTTOM NAV  — 全ページ共通
───────────────────────────────────────────────────── */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 560px;
  z-index: 100;
  display: flex;
  background: rgba(2,2,8,.9);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border-top: 1px solid rgba(212,175,55,.11);
}

.bnav-btn {
  flex: 1;
  padding: .65rem .4rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .16rem;
  cursor: pointer;
  background: transparent;
  border: none;
  text-decoration: none;
  transition: background .15s;
  position: relative;
}

.bnav-btn.active::after {
  content: '';
  position: absolute;
  top: 0; left: 22%; right: 22%;
  height: 1px;
  background: var(--g);
}

.bnav-ic {
  font-size: 1rem;
  color: var(--t3);
  transition: color .15s;
  line-height: 1;
}

.bnav-lbl {
  font-family: var(--fc);
  font-size: .38rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--t3);
  transition: color .15s;
}

.bnav-btn.active .bnav-ic,
.bnav-btn.active .bnav-lbl { color: var(--g); }
.bnav-btn:hover  .bnav-ic  { color: var(--t1); }

/* ─────────────────────────────────────────────────────
   ANIMATIONS  — 全ページ共通
───────────────────────────────────────────────────── */
@keyframes arise {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes scroll-bob {
  0%,100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(7px); }
}

.fade-in   { animation: arise .55s ease both; }
.fade-in-2 { animation: arise .55s .12s ease both; }
.fade-in-3 { animation: arise .55s .24s ease both; }

</style>
    </head>

    <body>

        <div id="pbar"></div>

        <header id="hdr">
            <div class="logo">Harmonic Bloom</div>
        </header>

        <section class="hero">
            <div class="layer" style="background-image:url('assets/images/midori.jpg');"></div>
            <div class="overlay"></div>

            <div class="text">
                <span class="num">01 / 静寂</span>
                <h1>静寂</h1>
                <p>stillness as a beginning</p>
            </div>
        </section>

        <section class="hero">
            <div class="layer" style="background-image:url('assets/images/S__47382534.jpg');"></div>
            <div class="overlay"></div>

            <div class="text">
                <h1>encounter</h1>
                <p>strength meets silence</p>
            </div>
        </section>

        <section class="hero">
            <div class="layer" style="background-image:url('assets/images/ki.jpg');"></div>
            <div class="overlay"></div>

            <div class="text">
                <h1>bloom</h1>
                <p>境界を越えて 花が開く</p>
            </div>
        </section>

        <section class="hero">
            <div class="layer" style="background-image:url('assets/images/cherryblossum.jpg');"></div>
            <div class="overlay"></div>

            <div class="text">
                <h1>harmony</h1>
                <p>where cultures bloom as one</p>
            </div>
        </section>

        <section class="outro">
            <h2>Harmonic Bloom</h2>
            <p>a portfolio by rin</p>
        </section>

        <script>
        /* Progress bar */
        const pbar = document.getElementById('pbar');
        window.addEventListener('scroll', () => {
            const h = document.body.scrollHeight - window.innerHeight;
            pbar.style.width = (window.scrollY / h * 100) + '%';
        }, { passive: true });

        /* IntersectionObserver でin-viewクラスを付与 */
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => {
            if (e.isIntersecting) e.target.classList.add('in-view');
            });
        }, { threshold: 0.25 });

        document.querySelectorAll('.hero, .outro').forEach(el => observer.observe(el));
        </script>
    </body>
</html>
